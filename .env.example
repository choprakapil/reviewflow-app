# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/review_assistant?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret-in-production"

# AI Provider API Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Upstash Redis (Optional for local dev rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 / S3 Asset Storage (Optional - falls back to local storage in dev)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

